PORT=4000
DATABASE_URL=postgres://user:password@host/afya

# Firebase Admin service account (JSON, as one line)
FIREBASE_SERVICE_ACCOUNT=

# Shared secret for the AI service; must match ai-service/.env. AI triage is disabled without it.
SERVICE_SECRET_KEY=
AI_SERVICE_URL=http://localhost:10000

# Extra allowed browser origins, comma-separated (exact match)
ALLOWED_ORIGINS=

# Africa's Talking (USSD + SMS)
AT_USERNAME=sandbox
AT_API_KEY=
# If set, the USSD callback URL must end in ?token=<this value>
AT_CALLBACK_SECRET=
